# Project-specific data directories
# ============================================================

# Uploaded videos and AI output files
backend/uploads/*
!backend/uploads/.gitkeep

# Output videos and raw JSON results
ai-pipeline/outputs/*
!ai-pipeline/outputs/.gitkeep

# Face crop images
*_faces/

