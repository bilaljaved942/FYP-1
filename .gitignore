env/
.env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# PyTest
.pytest_cache/
.coverage
htmlcov/

# ============================================================
# AI Model Weights (large files — download separately)
# ============================================================
*.pt
*.pth
*.onnx
*.keras
*.h5

